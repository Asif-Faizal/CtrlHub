{
  "id": "ctrlhubCampaign1",
  "name": "CtrlHub - Campaign delivery",
  "active": false,
  "nodes": [
    {
      "id": "8c2067f2-5048-5f69-b9b8-89b68a22676d",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "1d1e1855-da94-5f26-b412-8d3debf8aa4c",
      "name": "Refresh WhatsApp status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CTRLHUB_API_URL }}/automation/whatsapp/refresh-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.CTRLHUB_AUTOMATION_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "0e809514-6ab8-586f-9619-859e3870b466",
      "name": "Fetch due items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "={{ $env.CTRLHUB_API_URL }}/automation/campaigns/pending",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.CTRLHUB_AUTOMATION_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "25ffb77b-ecaf-54f0-b840-ebc6f083d8a0",
      "name": "Split items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      }
    },
    {
      "id": "b2b07916-f7ad-520f-b266-176ce1f10635",
      "name": "Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "7370bff8-e326-5c80-b148-1f3288d0cd80",
      "name": "Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CTRLHUB_API_URL }}/automation/campaigns/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.CTRLHUB_AUTOMATION_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tenant_id: $json.tenant_id, recipient_id: $json.recipient_id }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "3ff704d3-4218-58f3-8db6-89e4426f10cb",
      "name": "Throttle",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        100
      ],
      "webhookId": "cc940308-d906-5789-bf2f-17785746ba6a",
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "id": "048d4b6a-3a72-55c8-8132-6835035d7d0f",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "width": 640,
        "height": 200,
        "content": "## Campaign delivery\nEvery 15 minutes. Sends only APPROVED campaigns to recipients who opted in to marketing; consent is re-checked at send time. Throttled to one message every 5 seconds, 50 per run. The backend decides eligibility (consent, connected WhatsApp, enabled automation) and deduplicates every send, so re-running this workflow never double-sends. Uses $env.CTRLHUB_API_URL and $env.CTRLHUB_AUTOMATION_KEY."
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Refresh WhatsApp status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh WhatsApp status": {
      "main": [
        [
          {
            "node": "Fetch due items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch due items": {
      "main": [
        [
          {
            "node": "Split items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split items": {
      "main": [
        [
          {
            "node": "Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop": {
      "main": [
        [],
        [
          {
            "node": "Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send": {
      "main": [
        [
          {
            "node": "Throttle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Throttle": {
      "main": [
        [
          {
            "node": "Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {},
  "tags": []
}