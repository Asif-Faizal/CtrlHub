{
  "id": "ctrlhubHoliday01",
  "name": "CtrlHub - Holiday announcements",
  "active": false,
  "nodes": [
    {
      "id": "7427b6ac-5f3b-5ce7-a801-97c7512c9bdb",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "5d53516b-9677-52ec-9fc2-1bc1b4c7f448",
      "name": "Refresh WhatsApp status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CTRLHUB_API_URL }}/automation/whatsapp/refresh-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.CTRLHUB_AUTOMATION_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "dcb89b57-1175-5cd7-bdae-8048546c3863",
      "name": "Fetch due items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "={{ $env.CTRLHUB_API_URL }}/automation/notifications/due",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "type",
              "value": "holiday"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.CTRLHUB_AUTOMATION_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "35fe349e-6911-5dad-9dc1-f989e9899e22",
      "name": "Split items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      }
    },
    {
      "id": "1740292b-9ca3-5675-ac87-075f417b8d0e",
      "name": "Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "e397c773-3261-5417-aa2a-4c6a20d3e8b4",
      "name": "Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CTRLHUB_API_URL }}/automation/notifications/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.CTRLHUB_AUTOMATION_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tenant_id: $json.tenant_id, type: $json.type, dedupe_key: $json.dedupe_key }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "80164bdd-1901-58de-bf5a-f06df9c6b1f7",
      "name": "Throttle",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        100
      ],
      "webhookId": "c9f729cb-52b9-56cb-b845-6cf69ca32c59",
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      }
    },
    {
      "id": "3301113e-aebf-5622-9c19-314f3497cfe9",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "width": 640,
        "height": 200,
        "content": "## Holiday announcements\nDaily at 10:00. Notifies members for each holiday's advance-notice days. The backend decides eligibility (consent, connected WhatsApp, enabled automation) and deduplicates every send, so re-running this workflow never double-sends. Uses $env.CTRLHUB_API_URL and $env.CTRLHUB_AUTOMATION_KEY."
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Refresh WhatsApp status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh WhatsApp status": {
      "main": [
        [
          {
            "node": "Fetch due items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch due items": {
      "main": [
        [
          {
            "node": "Split items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split items": {
      "main": [
        [
          {
            "node": "Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop": {
      "main": [
        [],
        [
          {
            "node": "Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send": {
      "main": [
        [
          {
            "node": "Throttle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Throttle": {
      "main": [
        [
          {
            "node": "Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {},
  "tags": []
}