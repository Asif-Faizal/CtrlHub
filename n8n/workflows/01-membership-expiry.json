{
  "id": "ctrlhubExpiry001",
  "name": "CtrlHub - Membership expiry reminders",
  "active": false,
  "nodes": [
    {
      "id": "a381be45-71a6-512c-9aae-bb87ae33c503",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "c470c89c-5019-5187-901f-a9a5e8b834d1",
      "name": "Refresh WhatsApp status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CTRLHUB_API_URL }}/automation/whatsapp/refresh-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.CTRLHUB_AUTOMATION_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "89bc9157-7bf2-5156-87a9-a856627622bf",
      "name": "Fetch due items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "={{ $env.CTRLHUB_API_URL }}/automation/notifications/due",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "type",
              "value": "expiry"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.CTRLHUB_AUTOMATION_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "790d2512-b845-5e1e-ad58-0f1dc3609829",
      "name": "Split items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      }
    },
    {
      "id": "63f44412-2f6b-5f18-8c74-0aed3a42eea7",
      "name": "Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "54a213e8-b085-508c-b7ed-47a1731886c2",
      "name": "Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CTRLHUB_API_URL }}/automation/notifications/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.CTRLHUB_AUTOMATION_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tenant_id: $json.tenant_id, type: $json.type, dedupe_key: $json.dedupe_key }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "47a81913-2ad0-5eed-81e1-780eca82b4fa",
      "name": "Throttle",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        100
      ],
      "webhookId": "67ce1544-a670-531e-a781-f888562e09c3",
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      }
    },
    {
      "id": "6da5fd35-d9e7-5165-8de3-ec07b82fcbab",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "width": 640,
        "height": 200,
        "content": "## Membership expiry reminders\nDaily at 09:00. Sends reminders at each gym's configured offsets (default 7, 3, 1 days before and on the expiry day). The backend decides eligibility (consent, connected WhatsApp, enabled automation) and deduplicates every send, so re-running this workflow never double-sends. Uses $env.CTRLHUB_API_URL and $env.CTRLHUB_AUTOMATION_KEY."
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Refresh WhatsApp status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh WhatsApp status": {
      "main": [
        [
          {
            "node": "Fetch due items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch due items": {
      "main": [
        [
          {
            "node": "Split items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split items": {
      "main": [
        [
          {
            "node": "Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop": {
      "main": [
        [],
        [
          {
            "node": "Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send": {
      "main": [
        [
          {
            "node": "Throttle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Throttle": {
      "main": [
        [
          {
            "node": "Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {},
  "tags": []
}