# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# --- General ---
APP_ENV=production
# Public URL of the web dashboard (used in password setup links)
APP_BASE_URL=http://localhost:8081
WEB_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
DEFAULT_COUNTRY_CODE=91

# --- MySQL ---
MYSQL_DATABASE=ctrlhub
MYSQL_USER=ctrlhub
MYSQL_PASSWORD=CHANGE_ME_mysql_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password

# --- Backend auth ---
# At least 32 characters
JWT_SECRET=CHANGE_ME_at_least_32_random_characters_here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SETUP_TOKEN_TTL=48h
LOGIN_RATE_PER_MINUTE=10

# First platform administrator (created on first boot only)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_admin_password
PLATFORM_ADMIN_NAME="Platform Admin"

# Shared secret between n8n and the backend automation API (>= 24 chars)
AUTOMATION_API_KEY=CHANGE_ME_automation_key_at_least_24_chars

# --- Messaging ---
# mock = no real WhatsApp messages (default, safe). waha = real WhatsApp via WAHA.
MESSAGING_PROVIDER=mock
WAHA_API_KEY=CHANGE_ME_waha_api_key
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_waha_dashboard_password

# --- n8n ---
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption_key
N8N_HOST=localhost
N8N_PROTOCOL=http
# Set to true when n8n is served over HTTPS
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Kolkata
